{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "subtitle": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.custom.subtitle | default: product.type }}",
            "text_style": "subtitle"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 0,
            "show_inventory_quantity": false
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        }
      },
      "block_order": [
        "subtitle",
        "title",
        "price",
        "inventory",
        "buy_buttons",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust-badges": {
      "type": "product-trust-badges",
      "blocks": {
        "badge-1": {
          "type": "badge",
          "settings": {
            "label": "Omega-Schutz",
            "icon": "icon-heart"
          }
        },
        "badge-2": {
          "type": "badge",
          "settings": {
            "label": "Laborzertifiziert",
            "icon": "icon-clipboard"
          }
        },
        "badge-3": {
          "type": "badge",
          "settings": {
            "label": "Gentechnikfrei",
            "icon": "icon-leaf"
          }
        },
        "badge-4": {
          "type": "badge",
          "settings": {
            "label": "Vegan",
            "icon": "icon-leaf"
          }
        },
        "badge-5": {
          "type": "badge",
          "settings": {
            "label": "Omega-3-reich",
            "icon": "icon-heart"
          }
        },
        "badge-6": {
          "type": "badge",
          "settings": {
            "label": "Herstellung in Deutschland",
            "icon": "icon-lock"
          }
        }
      },
      "block_order": ["badge-1", "badge-2", "badge-3", "badge-4", "badge-5", "badge-6"],
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 28,
        "padding_bottom": 28
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "trust-badges",
    "related-products"
  ]
}
