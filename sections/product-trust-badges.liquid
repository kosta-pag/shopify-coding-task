{{ 'section-product-trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="trust-badges section-{{ section.id }}-padding">
  <div class="page-width">
    <ul class="trust-badges__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' and block.settings.label != blank -%}
          <li class="trust-badges__item" {{ block.shopify_attributes }}>
            <div class="trust-badges__icon">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 60 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                  width="30"
                  height="30"
                  loading="lazy"
                >
              {%- else -%}
                <span class="svg-wrapper">
                  {{- block.settings.icon | append: '.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </div>
            <span class="trust-badges__label caption">{{ block.settings.label }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Badge"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "icon-feature-shield", "label": "Shield (Schutz)" },
            { "value": "icon-feature-pipette", "label": "Pipette (Labor)" },
            { "value": "icon-feature-no-gmo", "label": "No GMO (Gentechnikfrei)" },
            { "value": "icon-feature-leaf", "label": "Leaf (Vegan)" },
            { "value": "icon-feature-droplet", "label": "Droplet (Omega-3)" },
            { "value": "icon-feature-germany", "label": "Germany (Herstellung)" }
          ],
          "default": "icon-feature-shield"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image (overrides icon)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-2",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "label": "Omega-Schutz", "icon": "icon-feature-shield" } },
        { "type": "badge", "settings": { "label": "Laborzertifiziert", "icon": "icon-feature-pipette" } },
        { "type": "badge", "settings": { "label": "Gentechnikfrei", "icon": "icon-feature-no-gmo" } },
        { "type": "badge", "settings": { "label": "Vegan", "icon": "icon-feature-leaf" } },
        { "type": "badge", "settings": { "label": "Omega-3-reich", "icon": "icon-feature-droplet" } },
        { "type": "badge", "settings": { "label": "Herstellung in Deutschland", "icon": "icon-feature-germany" } }
      ]
    }
  ]
}
{% endschema %}
